---
/**
 * 全ページ共通の枠。
 *
 * **電話番号を全ページの見える位置に置く（D-060）。**
 * 中小製造業の調達担当者は電話を使う。フォームだけに依存させない。
 * これは撤退設計でもある：我々の側で何かが止まっても、
 * 電話とメールが載っていれば、お客様の商売は止まらない（docs/17）。
 */
import "../styles/site.css";
import { companyName, tel, telHref, address, nav, headerNav, project, photoOf, photoSrc, isGeneral, receptionHours} from "../lib/site";
import { themeStyle, navId, heroId, sectionsId, headingsId, tablesId, motionId, webfont } from "../lib/theme";

const logo = photoOf("ロゴ");

interface Props {
  title: string;
  description?: string;
}
const { title, description = "" } = Astro.props;
const here = Astro.url.pathname;
const isHome = here === "/" || here === "";
/**
 * お問い合わせページでは、下の誘導帯を出さない。
 * **今いるページに「お問い合わせはこちら」と書いてある状態**になっていた。
 */
const isContact = here.startsWith("/contact");
const pageTitle = isHome ? `${companyName}｜${title}` : `${title}｜${companyName}`;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: companyName,
  telephone: tel || undefined,
  /** **聞いた読み方と受付時間を、構造化データにも出す**（D-425） */
  alternateName: (project.basics?.nameKana || undefined),
  hoursAvailable: receptionHours || undefined,
  address: address || undefined,
  foundingDate: project.basics?.founded || undefined,
  url: Astro.site?.href,
};
---
<!doctype html>
<html lang="ja" data-nav={navId} data-hero={heroId} data-motion={motionId} data-sections={sectionsId} data-headings={headingsId} data-tables={tablesId} style={themeStyle}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{pageTitle}</title>
  {description && <meta name="description" content={description} />}
  <link rel="canonical" href={new URL(here, Astro.site).href}>
  {webfont && (
    <>
      <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
      <link rel="stylesheet" href={webfont} />
    </>
  )}
  <meta property="og:title" content={pageTitle}>
  <meta property="og:type" content="website">
  {description && <meta property="og:description" content={description} />}
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline></script>
  <!--
    スマホのメニュー開閉。
    JSが動かない端末でも詰まないよう、フッターに同じリンクを全部置いてある
  -->
  <script is:inline>
    document.addEventListener("click", (e) => {
      const btn = e.target.closest(".nav-toggle");
      if (!btn) return;
      const open = btn.getAttribute("aria-expanded") === "true";
      btn.setAttribute("aria-expanded", String(!open));
      document.getElementById("site-menu")?.classList.toggle("open", !open);
    });
  </script>
</head>
<body>
  <header class="site-header">
    <div class="bar">
      {/**
        * **ロゴの横に会社名を出す**（D-460）。
        * ロゴ画像だけだと、**図像を知らない人には会社名が読めない。**
        * 画像があるときは `alt` を空にする——**名前は隣に文字で出ている**ので、
        * 読み上げで二度言わせない。画像が無いときは、いままでどおり名前だけ。
        */}
      <a class="logo" href="/">
        {logo && <img src={photoSrc(logo)} alt="" />}
        <span class="logo-name">{companyName}</span>
      </a>
      <div class="head-contact">
        {tel && (
          <a class="tel" href={`tel:${telHref}`}>
            <span class="tel-label">お電話でのお問い合わせ</span>
            <span class="tel-num">{tel}</span>
            {/**
              * **受付時間を出す**（D-425）。
              * 取材で必ず聞いているのに、**どのテンプレートも読んでいなかった。**
              * BtoBの製造業では「いつ電話してよいか」が分からないと、電話がかかってこない。
              * 聞けていない案件では、いままでと1文字も変わらない。
              */}
            {receptionHours && <span class="tel-hours">{receptionHours}</span>}
          </a>
        )}
        <a class="btn" href="/contact/">お問い合わせ</a>
      </div>
    </div>
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-menu">
      <span class="nav-bars" aria-hidden="true"></span>
      メニュー
    </button>
    <nav class="site-nav" id="site-menu" aria-label="メインメニュー">
      <ul>
        {headerNav.map((item) => (
          <li>
            <a href={item.href} aria-current={here === item.href ? "page" : undefined}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </header>

  <main>
    <slot />
  </main>

  <!--
    問い合わせの誘い文句は商品ごとに変える。
    **「図面をお持ちでしたら」は、加工屋にしか通じない。**
    汎用は業種を問わないので、どの業種でも成り立つ言い方にとどめる
  -->
  {!isContact && (
  <section class="cta">
    <div class="inner">
      <h2>{isGeneral ? "まずはお気軽にご相談ください" : "図面をお持ちでしたら、そのままご相談ください"}</h2>
      <p>
        {isGeneral
          ? "お電話・メールで承っております。"
          : "他社様で難しいと言われた案件も、一度ご相談ください。可否だけでもお答えします。"}
      </p>
      {/*
        **メールアドレスは、お問い合わせページにだけ置く。**
        誘導帯と全ページの脚に出していたため、13ページすべてに2回ずつ出ていた（D-175）。
        電話は残す。調達担当者は電話を使うし、撤退時にも生きる導線だから（D-060）。
      */}
      {/*
        電話番号もここには置かない。**頭にも脚にも出ている3つ目**になる。
        誘導帯は「一言＋ボタン1つ」に絞る（D-175）。
      */}
      <a class="btn btn-lg" href="/contact/">お問い合わせはこちら</a>
    </div>
  </section>
  )}

  <footer class="site-footer">
    <div class="inner">
      <p class="f-name">{companyName}</p>
      <p>
        {address}<br>
        {tel && <>TEL <a href={`tel:${telHref}`}>{tel}</a></>}
      </p>
      <ul class="f-nav">
        {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
      <p class="copy">© {new Date().getFullYear()} {companyName}</p>
    </div>
  </footer>
</body>
</html>
