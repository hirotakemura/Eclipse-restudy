---
/**
 * 強み・技術。**サイトで最も差がつくページ。**
 * 取材の追い質問で引き出した、社長自身が言語化できていなかった強みをここで言葉にする。
 */
import Base from "../layouts/Base.astro";
import Prose from "../components/Prose.astro";
import { project, companyName, isGeneral, reasonChosen, idealCustomer } from "../lib/site";
import { hasDraft } from "../lib/draft";

const s = project.strengths ?? ({} as any);
/** 原稿がまだ無い段階では、聞き取った内容をそのまま見出し付きで出す */
const blocks = (isGeneral
  ? [
      ["同業と比べて、どこが違うか", reasonChosen],
      ["他社様でお断りされた案件で、お受けできたもの", s.wonAfterOthersDeclined],
      ["お客様からよくいただく言葉", s.praiseFromClients],
      ["どういうお客様が多いか", idealCustomer],
      ["とくに力を入れているところ", s.followUpFindings],
    ]
  : [
      ["他社様で難しいと言われた案件", s.wonAfterOthersDeclined],
      ["お客様からよくいただく言葉", s.praiseFromClients],
      ["同業が敬遠しがちな仕事", s.workOthersAvoid],
      ["技術的に最も難しかった仕事", s.hardestJob],
      ["とくに力を入れているところ", s.followUpFindings],
    ]
).filter(([, v]) => v) as [string, string][];

const title = isGeneral ? "選ばれている理由" : "強み・技術";
const lead = isGeneral
  ? "なぜ、お客様に選んでいただけているのか。"
  : "なぜ他社様で難しいと言われた案件をお受けできるのか。";
---
<Base title={title} description={`${companyName}が選ばれている理由`}>
  <div class="page-head"><div class="inner">
    <h1>{title}</h1>
    <p>{lead}</p>
  </div></div>
  <section class="section"><div class="inner">
    <Prose slug="strengths" />
    {!hasDraft("strengths") && blocks.map(([heading, body]) => (
      <>
        <h2>{heading}</h2>
        <p>{body}</p>
      </>
    ))}
    {!isGeneral && s.defectRate && (
      <>
        <h2>品質</h2>
        <p>不良率：{s.defectRate}</p>
      </>
    )}
  </div></section>
</Base>
