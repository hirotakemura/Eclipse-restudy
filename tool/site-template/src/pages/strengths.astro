---
/**
 * 強み・技術。**サイトで最も差がつくページ。**
 *
 * 骨格はこのファイルが決めない。`lib/design/sections.ts` が案件データと型から決める（D-188）。
 * 直す前は「見出し→本文」を5回繰り返すだけで、どれが重いのか分からなかった。
 *
 * **見せ方も、このファイルが決めない**（D-233）。
 * 直す前はここで `sec.kind` を見て部品を直書きしていたため、
 * design engine が選んだ `presentation` が**このページには一切届いていなかった。**
 * それでいて `data-presentation` 属性だけは出していたので、
 * **属性は「largeNumber」なのに画面は表**、という食い違いが起きていた（D-228・D-229）。
 * 描き分けは `Present.astro` が単一の正。ここは帯を置くだけにする。
 */
import Base from "../layouts/Base.astro";
import Band from "../components/Band.astro";
import Present from "../components/Present.astro";
import { analyze } from "../../../lib/design/analysis.ts";
import { composePage } from "../../../lib/design/sections.ts";
import { composeVisual } from "../../../lib/design/visual.ts";
import { composeAssets, willDraw } from "../../../lib/design/assets.ts";
import { project, companyName, isGeneral, depthOf, descriptionOf } from "../lib/site";
import { theme } from "../lib/theme";
import { hasDraft } from "../lib/draft";

const analysis = analyze(project as any);
const sections = composeAssets(
  composeVisual(composePage("strengths", project as any, analysis, {
    direction: theme.direction,
    hasProse: hasDraft("strengths"),
    depth: depthOf("strengths"),
  }), project as any, analysis, { direction: theme.direction }),
  project as any, analysis, { direction: theme.direction, page: "strengths" },
).filter((s) => willDraw(s, project as any, "strengths"));

const title = isGeneral ? "選ばれている理由" : "強み・技術";
const lead = isGeneral
  ? "なぜ、お客様に選んでいただけているのか。"
  : "なぜ他社様で難しいと言われた案件をお受けできるのか。";
---
<Base title={title} description={descriptionOf("strengths")}>
  <div class="page-head"><div class="inner">
    <h1>{title}</h1>
    <p>{lead}</p>
  </div></div>

  {sections.map((sec) => (
    <Band width={sec.width} emphasis={sec.emphasis} surface={sec.surface} motif={sec.motif} content={sec.content} presentation={sec.presentation}
          decidedBy={sec.decidedBy} density={sec.visual?.density} peak={sec.visual?.peak} role={sec.visual?.role} layout={sec.visual?.layout ?? sec.layout}
          assetSource={sec.asset?.source} assetIntent={sec.asset?.intent} assetRole={sec.asset?.role} assetSubject={sec.asset?.subject} assetWanted={sec.asset?.wanted?.category} assetPriority={sec.asset?.wanted?.priority} assetLibrary={sec.asset?.library?.id} assetImage={sec.asset?.library?.path} heading={sec.kind === "prose" ? undefined : sec.heading}>
      <Present content={sec.content} presentation={sec.presentation} analysis={analysis} slug="strengths" />
    </Band>
  ))}
</Base>
