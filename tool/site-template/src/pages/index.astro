---
/**
 * トップページ。
 *
 * 調達担当者が10秒で「この会社は自分の案件を受けられるか」を判断できるようにする。
 * **判断に使われるのは、対応材質・加工法・ロット・納期の4つ。**
 * 会社の理念や社長の想いは、判断したあとで読まれる（docs/06 ブロック2）。
 */
import Base from "../layouts/Base.astro";
import Prose from "../components/Prose.astro";
import CaseCard from "../components/CaseCard.astro";
import { project, companyName, cases, photoOf, photosOf, isGeneral, offerings, serviceArea, reasonChosen, caseHref } from "../lib/site";
import { heroId } from "../lib/theme";
import Figure from "../components/Figure.astro";
import Gallery from "../components/Gallery.astro";

const cap = project.capability ?? ({} as any);

/**
 * 10秒で「自分の用は足りるか」を判断してもらうための札。
 *
 * 製造業なら「材質・加工法・ロット・納期」、
 * 汎用なら「対応エリアと、何を扱っているか」。**業種が違っても、見る人の問いは同じ。**
 */
const facts = (isGeneral
  ? [
      serviceArea ? `対応エリア：${serviceArea.split(/[。\n]/)[0]!.slice(0, 28)}` : null,
      ...offerings.slice(0, 4).map((o: any) => o.name).filter(Boolean),
    ]
  : [
      cap.materials?.length ? `材質：${cap.materials.slice(0, 5).join("・")}` : null,
      cap.processes?.length ? `加工：${cap.processes.slice(0, 5).join("・")}` : null,
      cap.lotSize ? `ロット：${cap.lotSize}` : null,
      cap.shortestLeadTime ? `納期：${cap.shortestLeadTime}` : null,
      cap.certifications?.length ? cap.certifications.join("・") : null,
    ]
).filter(Boolean) as string[];

/**
 * 「対応範囲を先に出す」型のときに、最初の画面に置く項目。
 * **札（facts）より情報量を増やす。**判断に使う数字をそのまま見せる
 */
const specs = (isGeneral
  ? [
      ["対応エリア", serviceArea],
      ["主な取り扱い", offerings.map((o: any) => o.name).filter(Boolean).join("・")],
    ]
  : [
      ["対応材質", cap.materials?.join("・")],
      ["加工法・工法", cap.processes?.join("・")],
      ["対応ロット", cap.lotSize],
      ["最短納期", cap.shortestLeadTime],
      ["対応精度", cap.tolerance],
      ["資格・認証", cap.certifications?.join("・")],
    ]
).filter(([, v]) => v) as [string, string][];

const declined = project.strengths?.wonAfterOthersDeclined;
const desc = [project.basics?.address, cap.processes?.join("・"), cap.materials?.join("・")]
  .filter(Boolean).join("／");
---
<Base title="トップ" description={`${companyName}｜${desc}`}>
  <section class="hero">
    <div class="inner">
      <h1>{companyName}</h1>
      <p class="lead">{project.basics?.businessSummary}</p>
      {heroId === "spec" && specs.length > 0 ? (
        <dl class="spec-first">
          {specs.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
        </dl>
      ) : (
        facts.length > 0 && <div class="facts">{facts.map((f) => <span>{f}</span>)}</div>
      )}
      <Figure photo={photoOf("外観")} className="hero-photo" eager={true} />
    </div>
  </section>

  <Prose slug="index" />

  {isGeneral && offerings.length > 0 && (
    <section class="section">
      <div class="inner">
        <h2>取り扱い</h2>
        {offerings.slice(0, 4).map((o: any) => (
          <div class="offering">
            <h3>{o.name}</h3>
            {o.detail && <p>{o.detail}</p>}
            {o.price && <p class="price"><span>料金の目安</span>{o.price}</p>}
          </div>
        ))}
        <p><a href="/services/">サービス・料金をすべて見る</a></p>
      </div>
    </section>
  )}

  {isGeneral && reasonChosen && (
    <section class="section">
      <div class="inner">
        <h2>選ばれている理由</h2>
        <div class="note-box">{reasonChosen}</div>
        <p><a href="/strengths/">くわしく見る</a></p>
      </div>
    </section>
  )}

  {!isGeneral && declined && (
    <section class="section">
      <div class="inner">
        <h2>他社様で難しいと言われた案件</h2>
        <div class="note-box">{declined}</div>
        <p><a href="/strengths/">なぜ受けられるのか（強み・技術）</a></p>
      </div>
    </section>
  )}

  {cases.length > 0 && (
    <section class="section">
      <div class="inner">
        <h2>{isGeneral ? "実績" : "加工事例"}</h2>
        <div class="cards">
          {cases.slice(0, 6).map((c, i) => <CaseCard index={i} item={c} />)}
        </div>
        {cases.length > 6 && (
          <p style="margin-top:20px"><a href="/cases/">{isGeneral ? "実績" : "加工事例"}をすべて見る</a></p>
        )}
        <Gallery photos={photosOf("工場・設備").slice(0, 3)} heading="工場・設備" />
      </div>
    </section>
  )}
</Base>
