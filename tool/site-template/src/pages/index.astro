---
/**
 * トップページ。
 *
 * **骨格をこのファイルが決めない。**
 * 何をどの順で、どの幅・どの強さで出すかは `lib/design/sections.ts` が案件データから決める。
 * ここは返ってきた配列を描くだけにする（D-180）。
 *
 * 直す前は、全ページが「`.section` 1つ・幅1040px」の同じ形だった。
 * 配色や書体を変えても同じ顔に見えるのは、装飾しか変わっていなかったから（docs/21）。
 */
import Base from "../layouts/Base.astro";
import Band from "../components/Band.astro";
import Present from "../components/Present.astro";
import Figure from "../components/Figure.astro";
import { analyze } from "../../../lib/design/analysis.ts";
import { composeTop, resolveHero } from "../../../lib/design/sections.ts";
import { composeVisual } from "../../../lib/design/visual.ts";
import { composeAssets, willDraw, assetImageOf } from "../../../lib/design/assets.ts";
/** **見出しの大きさは、中身の長さで決める**（D-277）。長文を巨大に組まない */
import { fit } from "../../../lib/design/system/typography.ts";
import { project, designBrief, companyName, cases, photoOf, realPhotoOf, photosOf, isGeneral, offerings, serviceArea, reasonChosen, webOf } from "../lib/site";
import { heroId, theme } from "../lib/theme";
import { hasDraft } from "../lib/draft";

const cap = (project as any).capability ?? {};
const st = (project as any).strengths ?? {};
const defectRate = (st.defectRate ?? "").trim();
const basics = (project as any).basics ?? {};

/** **見立ても構成も、サニタイズ済みのデータから作る。** 未確認の項目は先に落ちている */
const analysis = analyze(project as any);
// **原稿がまだ無い段階で、空の帯を出さない。** 罫線と余白だけの帯は壊れて見える
/**
 * **型（方向性）を必ず渡す。**
 * 渡し忘れていたため、段階2で作った「型が構成を変える」が
 * **トップページにだけ届いていなかった**（D-203）。
 * 強み・技術などのページでは渡していたので、机上の確認では気づけなかった。
 */
/** 選んだ型に材料が無ければ、その型の次の候補へ落とす（D-203） */
const hero = resolveHero(heroId, analysis, theme.direction);
/**
 * **保存された Brief があれば、それに従う**（AI版）。
 * 無ければ規則版が決める。**ここでAIを呼ぶことはない。**
 */
const sections = composeAssets(
  composeVisual(composeTop(project as any, analysis, {
    hero,
    direction: theme.direction,
    hasProse: hasDraft("index"),
    brief: designBrief,
  }), project as any, analysis, { direction: theme.direction }),
  project as any, analysis, { direction: theme.direction, page: "index" },
).filter((s) => willDraw(s, project as any, "index"));

/**
 * 10秒で「自分の用は足りるか」を判断してもらうための札。
 * 製造業なら「材質・加工法・ロット・納期」、汎用なら「対応エリアと、何を扱っているか」。
 */
const facts = (isGeneral
  ? [
      serviceArea ? `対応エリア：${serviceArea.split(/[。\n]/)[0]!.slice(0, 28)}` : null,
      ...offerings.slice(0, 4).map((o: any) => o.name).filter(Boolean),
    ]
  : [
      cap.materials?.length ? `材質：${cap.materials.slice(0, 5).join("・")}` : null,
      cap.processes?.length ? `加工：${cap.processes.slice(0, 5).join("・")}` : null,
      cap.lotSize ? `ロット：${cap.lotSize}` : null,
      cap.shortestLeadTime ? `納期：${cap.shortestLeadTime}` : null,
      /** **不良率は、短く言い切れるときだけ札に出す**（D-432）。長い説明を札にしない */
      defectRate && defectRate.length <= 14 && /\d/.test(defectRate) ? `不良率：${defectRate}` : null,
      cap.certifications?.length ? cap.certifications.join("・") : null,
    ]
).filter(Boolean) as string[];

/** 「対応範囲を先に出す」型のときに、最初の画面に置く項目 */
const specs = (isGeneral
  ? [
      ["対応エリア", serviceArea],
      ["主な取り扱い", offerings.map((o: any) => o.name).filter(Boolean).join("・")],
    ]
  : [
      ["対応材質", cap.materials?.join("・")],
      ["加工法・工法", cap.processes?.join("・")],
      ["対応ロット", cap.lotSize],
      ["最短納期", cap.shortestLeadTime],
      ["対応精度", cap.tolerance],
      /** **不良率は「条件」ではなく実績だが、判断に使う数字である**（D-432） */
      ["不良率", defectRate],
      ["資格・認証", cap.certifications?.join("・")],
    ]
).filter(([, v]) => v) as [string, string][];

const desc = [basics.address, cap.processes?.join("・"), cap.materials?.join("・")].filter(Boolean).join("／");
---
<Base title="トップ" description={`${companyName}｜${desc}`}>
  {sections.map((s) => {
    /*
      最初の画面の地に、生成ビジュアルを敷く（第9段階）。
      **絵が無ければ属性もつかない**ので、いままでと1ピクセルも変わらない。
      見出し・導入・札は**そのまま上に乗る**（「AI画像＋普通の見出し」にしない）。
    */
    if (s.kind === "hero") return (
      <section class="hero" data-motif={s.motif !== "none" ? s.motif : undefined}
        data-asset-source={assetImageOf(s.asset) ? s.asset?.source : undefined}
        data-asset-generated={s.asset?.generated?.id}
        data-asset-safe={s.asset?.generated?.safe}
        style={s.asset?.generated ? `--asset-image:url(${s.asset.generated.path});--asset-focal:${s.asset.generated.focal}` : undefined}>
        <div class="inner">
          {/*
            最初の画面は6通り（lib/design/system/hero.ts）。
            **6つ中5つは写真が無くても成立する。** 写真ゼロの会社でも型ごとに違って見えるように（ご指示②）
          */}
          {hero === "figure" && analysis.heroFigure ? (
            <>
              <p class="hero-kicker">{companyName}</p>
              <p class="hero-figure-label">{analysis.heroFigure.label}</p>
              <p class="hero-figure">{analysis.heroFigure.value}</p>
              <h1 class="hero-sub" data-role={fit("statement", basics.businessSummary ?? "").id}>{webOf("basics.businessSummary", basics.businessSummary)}</h1>
            </>
          ) : hero === "type" ? (
            <>
              <h1 class="hero-type">{companyName}</h1>
              <p class="lead hero-type-lead">{webOf("basics.businessSummary", basics.businessSummary)}</p>
            </>
          ) : hero === "motif" ? (
            <>
              <p class="hero-kicker">{companyName}</p>
              <h1 class="hero-motif" data-role={fit("heroTitle", basics.businessSummary ?? "").id}>{webOf("basics.businessSummary", basics.businessSummary)}</h1>
              {facts.length > 0 && <div class="facts">{facts.slice(0, 3).map((f) => <span>{f}</span>)}</div>}
            </>
          ) : (
            <>
              <h1>{companyName}</h1>
              <p class="lead">{webOf("basics.businessSummary", basics.businessSummary)}</p>
              {hero === "spec" && specs.length > 0 ? (
                <dl class="spec-first">
                  {specs.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
                </dl>
              ) : (
                facts.length > 0 && <div class="facts">{facts.map((f) => <span>{f}</span>)}</div>
              )}
            </>
          )}
          {/*
            **最初の画面には、実写だけを置く**（第7段階）。
            仮の画像を置くと、写真0枚の会社では**それがページ最大の視覚物**になる。
            仮の画像は写真の帯にはこれまでどおり出る（D-242）。
          */}
          <Figure photo={realPhotoOf("外観")} className="hero-photo" eager={true} />
        </div>
      </section>
    );

    return (
      <Band width={s.width} emphasis={s.emphasis} surface={s.surface} motif={s.motif} content={s.content} presentation={s.presentation} decidedBy={s.decidedBy} reference={s.reference} density={s.visual?.density} peak={s.visual?.peak} peakText={s.visual?.peakText} role={s.visual?.role} layout={s.visual?.layout ?? s.layout}
            assetSource={s.asset?.source} assetIntent={s.asset?.intent} assetRole={s.asset?.role} assetSubject={s.asset?.subject} assetWanted={s.asset?.wanted?.category} assetPriority={s.asset?.wanted?.priority} assetLibrary={s.asset?.library?.id} assetGenerated={s.asset?.generated?.id} assetImage={assetImageOf(s.asset)} assetFocal={s.asset?.generated?.focal}
            heading={s.kind === "prose" ? undefined : s.heading}>
        <Present content={s.content} presentation={s.presentation} decidedBy={s.decidedBy} analysis={analysis} slug={s.slug} />
      </Band>
    );
  })}

  {/*
    **取り扱いは、ここに書かない**（D-272）。
    以前はここに直接書いていたため、可否表も材料条件も Brief も通らず、
    幅も強さも固定だった。いまは `composeTop()` が構成の中に置く。
  */}
</Base>
