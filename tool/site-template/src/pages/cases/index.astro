---
import Base from "../../layouts/Base.astro";
import CaseCard from "../../components/CaseCard.astro";
import { cases, companyName } from "../../lib/site";
---
<Base title="加工事例" description={`${companyName}の加工事例。他社で断られた案件の解決例を掲載しています`}>
  <div class="page-head"><div class="inner">
    <h1>加工事例</h1>
    <p>お客様の社名は伏せております。</p>
  </div></div>
  <section class="section"><div class="inner">
    <div class="cards">
      {cases.map((c, i) => <CaseCard index={i} item={c} />)}
    </div>
  </div></section>
</Base>
