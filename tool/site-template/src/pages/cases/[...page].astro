---
/**
 * 加工事例の一覧。
 *
 * **骨格も見せ方も、このファイルが決めない**（D-301）。
 * 直す前はカードの格子が1つ置いてあるだけで、帯が無く、山も余白の変化も無かった。
 */
import Base from "../../layouts/Base.astro";
import Band from "../../components/Band.astro";
import Present from "../../components/Present.astro";
import { analyze } from "../../../../lib/design/analysis.ts";
import { composePage } from "../../../../lib/design/sections.ts";
import { composeVisual } from "../../../../lib/design/visual.ts";
import { composeAssets, willDraw } from "../../../../lib/design/assets.ts";
import { project, companyName, isGeneral, photosOf, narrowTo, depthOf, descriptionOf, buildsPage } from "../../lib/site";
import { theme } from "../../lib/theme";

const analysis = analyze(project as any);
/** 写真の帯が見るのは**加工事例の写真**。工場の写真ではない */
const source = narrowTo({ photos: photosOf("加工事例") });
const sections = composeAssets(
  composeVisual(
    composePage("cases", source, analysis, { direction: theme.direction, depth: depthOf("cases") }),
    source, analysis, { direction: theme.direction },
  ),
  source, analysis, { direction: theme.direction, page: "cases" },
).filter((s) => willDraw(s, source, "cases"));
const title = isGeneral ? "実績" : "加工事例";
/**
 * **事例が1件も無ければ、このページは作らない**（第6.5段階）。
 *
 * ここだけ `getStaticPaths` を持っていなかったため、
 * 事例0件の会社でも**メニューにも sitemap にも載っていない空のページ**が
 * 書き出されていた（実測：9ページ書き出し・sitemap 8件）。
 * 静的な `index.astro` では作るかどうかを選べないので、
 * 対応可能範囲・設備一覧と同じ形（`[...page].astro`）に揃える。URLは `/cases/` のまま。
 */
export function getStaticPaths() {
  return buildsPage("cases") ? [{ params: { page: undefined } }] : [];
}

---
<Base title={title} description={descriptionOf("cases")}>
  <div class="page-head"><div class="inner">
    <h1>{title}</h1>
    <p>お客様の社名は伏せております。</p>
  </div></div>
  {sections.map((sec) => (
    <Band width={sec.width} emphasis={sec.emphasis} surface={sec.surface} motif={sec.motif} content={sec.content} presentation={sec.presentation}
          decidedBy={sec.decidedBy} density={sec.visual?.density} peak={sec.visual?.peak} role={sec.visual?.role} layout={sec.visual?.layout ?? sec.layout}
          assetSource={sec.asset?.source} assetIntent={sec.asset?.intent} assetRole={sec.asset?.role} assetSubject={sec.asset?.subject} assetWanted={sec.asset?.wanted?.category} assetPriority={sec.asset?.wanted?.priority} assetLibrary={sec.asset?.library?.id} assetImage={sec.asset?.library?.path} heading={sec.kind === "prose" ? undefined : sec.heading}>
      <Present content={sec.content} presentation={sec.presentation} analysis={analysis} slug="cases" />
    </Band>
  ))}
</Base>
