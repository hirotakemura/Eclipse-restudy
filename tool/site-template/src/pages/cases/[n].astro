---
/**
 * 加工事例の個別ページ。**最も読まれ、最も問い合わせに繋がる。**
 * 調達担当者は「自分の案件と似た仕事をやったことがあるか」だけを見ている。
 *
 * **`confidentialityNotes` は絶対に出力しない。**
 * あれは「何を伏せるか」を我々が控えた項目であって、掲載する内容ではない。
 *
 * **骨格も見せ方も、このファイルが決めない**（D-301）。
 * 直す前はこのページに帯が1本も無く、見出しと本文が同じ間隔で続くだけだった。
 * サイトで最も読まれるページが、トップとは別物に見えていた。
 */
import Base from "../../layouts/Base.astro";
import Band from "../../components/Band.astro";
import Present from "../../components/Present.astro";
import { analyze } from "../../../../lib/design/analysis.ts";
import { composePage } from "../../../../lib/design/sections.ts";
import { composeVisual } from "../../../../lib/design/visual.ts";
import { composeAssets, willDraw } from "../../../../lib/design/assets.ts";
import { project, cases, isGeneral, photosOfCase, narrowTo } from "../../lib/site";
import { theme } from "../../lib/theme";
import { hasDraft } from "../../lib/draft";

export function getStaticPaths() {
  // 汎用ベーシックは事例を1ページにまとめる。個別ページは作らない
  if (isGeneral) return [];
  return (cases ?? []).map((item, i) => ({
    params: { n: String(i + 1) },
    props: { item, index: i },
  }));
}
const { item, index } = Astro.props;
const n = index + 1;
const slug = `case-${n}`;

const analysis = analyze(project as any);
/**
 * **材料を数える範囲は、この1件だけ。**
 * 全件で数えると、写真の無い事例に「加工したもの」の帯が空のまま出る。
 * 見立て（`analyze`）は会社の性格なので、絞らずそのまま渡す。
 */
const source = narrowTo({
  /** **この画面は事例の個別ページである**、と材料の数え方に伝える（`materialsOf`） */
  caseDetail: true,
  cases: [item],
  photos: photosOfCase(n),
  /** 材質・加工法の札は、**この案件のもの**を出す。会社の対応材質ではない */
  capability: { ...((project as any).capability ?? {}), materials: item.materials ?? [], processes: item.processes ?? [] },
});
const sections = composeAssets(
  composeVisual(
    composePage("case", source, analysis, { direction: theme.direction, hasProse: hasDraft(slug) }),
    source, analysis, { direction: theme.direction },
  ),
  source, analysis, { direction: theme.direction, page: "case" },
).filter((s) => willDraw(s, source, "case"));
---
<Base title={`加工事例：${item.title}`} description={`${item.clientIndustry}｜${item.partDescription ?? ""}`}>
  <div class="page-head"><div class="inner">
    <p>{item.clientIndustry}</p>
    <h1>{item.title}</h1>
  </div></div>
  {sections.map((sec) => (
    <Band width={sec.width} emphasis={sec.emphasis} surface={sec.surface} motif={sec.motif} content={sec.content} presentation={sec.presentation}
          decidedBy={sec.decidedBy} density={sec.visual?.density} peak={sec.visual?.peak} role={sec.visual?.role} layout={sec.visual?.layout ?? sec.layout}
          assetSource={sec.asset?.source} assetIntent={sec.asset?.intent} assetRole={sec.asset?.role} assetSubject={sec.asset?.subject} assetWanted={sec.asset?.wanted?.category} assetPriority={sec.asset?.wanted?.priority} assetLibrary={sec.asset?.library?.id} assetImage={sec.asset?.library?.path} heading={sec.kind === "prose" ? undefined : sec.heading}>
      <Present content={sec.content} presentation={sec.presentation} analysis={analysis} slug="case" caseNo={n} draftSlug={slug} />
    </Band>
  ))}
  <div class="section"><div class="inner">
    <p><a href="/cases/">加工事例の一覧に戻る</a></p>
  </div></div>
</Base>
