---
/**
 * 設備一覧。
 *
 * **設備の型番そのものが検索される。**「この設備を持つ会社を探している」という検索が実在する。
 * だからこそ、型番は推測で書かない。聞き取ったデータをそのまま出す（D-095）。
 *
 * 骨格はこのファイルが決めない（D-188）。
 * **型番まで分かっている設備は前に出し、一覧表はその後ろに置く。**
 *

 * **見せ方はこのファイルが決めない**（D-233）。
 * 直す前は `sec.kind` を見て部品を直書きしていたため、design engine が選んだ
 * `presentation` が**このページには届いていなかった。**それでいて属性だけは
 * 出していたので、**属性と画面が食い違っていた**（D-228・D-229）。
 * 描き分けは `Present.astro` が単一の正。ここは帯を置くだけにする。
 */
import Base from "../../layouts/Base.astro";
import Band from "../../components/Band.astro";
import Present from "../../components/Present.astro";
import { analyze } from "../../../../lib/design/analysis.ts";
import { composePage } from "../../../../lib/design/sections.ts";
import { composeVisual } from "../../../../lib/design/visual.ts";
import { composeAssets, willDraw } from "../../../../lib/design/assets.ts";
import { project, companyName, photosOf, isGeneral } from "../../lib/site";
import { theme } from "../../lib/theme";
import { hasDraft } from "../../lib/draft";

/**
 * `note` は**社内のメモ欄**なので、表には出さない。
 * 「型番は社長の口頭記憶のため、現地で銘板と照合して確定させること」が
 * そのままメーカー欄に出て公開された（D-169）。
 */
const equipment = (project.capability?.equipment ?? []).filter((e: any) => e.maker || e.model);
const total = equipment.reduce((s: number, e: any) => s + (Number(e.count) || 0), 0);

const analysis = analyze(project as any);
const sections = composeAssets(
  composeVisual(composePage("equipment", project as any, analysis, {
    direction: theme.direction,
    hasProse: hasDraft("equipment"),
  }), project as any, analysis, { direction: theme.direction }),
  project as any, analysis, { direction: theme.direction, page: "equipment" },
).filter((s) => willDraw(s, project as any, "equipment"));

/**
 * 製造業向けの案件でだけ作るページ。
 * 汎用ベーシック（198,000円）には対応材質も設備一覧も無いので、空の表だけのページを作らない。
 */
export function getStaticPaths() {
  return isGeneral ? [] : [{ params: { page: undefined } }];
}
---
<Base title="設備一覧" description={`${companyName}の保有設備一覧（メーカー・型番・台数）`}>
  <div class="page-head"><div class="inner">
    <h1>設備一覧</h1>
    {total > 0 && <p>保有設備 {total}台</p>}
  </div></div>

  {sections.map((sec) => (
    <Band width={sec.width} emphasis={sec.emphasis} surface={sec.surface} motif={sec.motif} content={sec.content} presentation={sec.presentation}
          decidedBy={sec.decidedBy} density={sec.visual?.density} peak={sec.visual?.peak} role={sec.visual?.role} layout={sec.visual?.layout ?? sec.layout}
          assetSource={sec.asset?.source} assetIntent={sec.asset?.intent} assetRole={sec.asset?.role} assetSubject={sec.asset?.subject} assetWanted={sec.asset?.wanted?.category} assetPriority={sec.asset?.wanted?.priority} assetLibrary={sec.asset?.library?.id} assetImage={sec.asset?.library?.path} heading={sec.kind === "prose" ? undefined : sec.heading}>
      <Present content={sec.content} presentation={sec.presentation} analysis={analysis} slug="equipment" />
      {sec.kind === "equipmentTable" && equipment.length === 0 && <p>設備の詳細はお問い合わせください。</p>}
    </Band>
  ))}
</Base>
