---
/**
 * 対応可能範囲。**SEOの本体。**
 * 調達担当者は「材質 × 加工法 × 条件」で検索する。この表があるかで検索に出るかが決まる。
 *
 * 骨格はこのファイルが決めない（D-188）。表は聞き取ったデータをそのまま出す（D-095）。
 * 直す前は「本文→表」を1040pxの帯1つで出すだけで、
 * **最も見られる条件（ロット・納期）が表の1行に埋もれていた。**
 *

 * **見せ方はこのファイルが決めない**（D-233）。
 * 直す前は `sec.kind` を見て部品を直書きしていたため、design engine が選んだ
 * `presentation` が**このページには届いていなかった。**それでいて属性だけは
 * 出していたので、**属性と画面が食い違っていた**（D-228・D-229）。
 * 描き分けは `Present.astro` が単一の正。ここは帯を置くだけにする。
 */
import Base from "../../layouts/Base.astro";
import Band from "../../components/Band.astro";
import Present from "../../components/Present.astro";
import { analyze } from "../../../../lib/design/analysis.ts";
import { composePage } from "../../../../lib/design/sections.ts";
import { composeVisual } from "../../../../lib/design/visual.ts";
import { composeAssets } from "../../../../lib/design/assets.ts";
import { project, rows, companyName, isGeneral } from "../../lib/site";
import { theme } from "../../lib/theme";
import { hasDraft } from "../../lib/draft";

const cap = project.capability ?? ({} as any);
const spec = rows([
  ["対応材質", cap.materials],
  ["加工法・工法", cap.processes],
  ["対応サイズ（最大）", cap.maxSize],
  ["対応サイズ（最小）", cap.minSize],
  ["対応精度", cap.tolerance],
  ["対応ロット", cap.lotSize],
  ["最短納期", cap.shortestLeadTime],
  ["試作と量産の比率", cap.prototypeRatio],
  ["資格・認証", cap.certifications],
  ["稼働体制", cap.operatingHours],
]);

const analysis = analyze(project as any);
const sections = composeAssets(
  composeVisual(composePage("capability", project as any, analysis, {
    direction: theme.direction,
    hasProse: hasDraft("capability"),
  }), project as any, analysis, { direction: theme.direction }),
  project as any, analysis, { direction: theme.direction, page: "capability" },
);

/**
 * 製造業向けの案件でだけ作るページ。
 * 汎用ベーシック（198,000円）には対応材質も設備一覧も無いので、空の表だけのページを作らない。
 */
export function getStaticPaths() {
  return isGeneral ? [] : [{ params: { page: undefined } }];
}
---
<Base title="対応可能範囲" description={`${companyName}の対応材質・加工法・精度・ロット・納期の一覧`}>
  <div class="page-head"><div class="inner">
    <h1>対応可能範囲</h1>
    <p>材質・加工法・サイズ・精度・ロット・納期の一覧です。</p>
  </div></div>

  {sections.map((sec) => (
    <Band width={sec.width} emphasis={sec.emphasis} surface={sec.surface} motif={sec.motif} content={sec.content} presentation={sec.presentation}
          decidedBy={sec.decidedBy} density={sec.visual?.density} peak={sec.visual?.peak} role={sec.visual?.role} layout={sec.visual?.layout ?? sec.layout}
          assetSource={sec.asset?.source} assetIntent={sec.asset?.intent} assetRole={sec.asset?.role} assetSubject={sec.asset?.subject} assetWanted={sec.asset?.wanted?.category} heading={sec.kind === "prose" ? undefined : sec.heading}>
      <Present content={sec.content} presentation={sec.presentation} analysis={analysis} slug="capability" />
      {/* 表そのものではなく、**この帯に添える一文**。見せ方の分岐ではない */}
      {sec.kind === "specTable" && <p>記載のない条件についても、まずはご相談ください。可否だけでもお答えします。</p>}
    </Band>
  ))}
</Base>
