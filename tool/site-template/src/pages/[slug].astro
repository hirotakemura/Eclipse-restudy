---
/**
 * 採用情報・代表挨拶。
 *
 * **サイトの役割（集客／選別／採用／信用構築）に応じて、出したり出さなかったりする。**
 * 採用の予定がない会社に採用ページを作っても、更新されないページが1枚増えるだけ。
 *
 * **骨格も見せ方も、このファイルが決めない**（D-301）。
 * 直す前は「見出し→本文」を繰り返すだけで、帯が1本も無かった。
 */
import Base from "../layouts/Base.astro";
import Band from "../components/Band.astro";
import Present from "../components/Present.astro";
import { analyze } from "../../../lib/design/analysis.ts";
import { composePage } from "../../../lib/design/sections.ts";
import { composeVisual } from "../../../lib/design/visual.ts";
import { project, hasRecruit, hasMessage, companyName, photosOf, narrowTo } from "../lib/site";
import { theme } from "../lib/theme";
import { hasDraft } from "../lib/draft";

export function getStaticPaths() {
  const paths = [];
  if (hasRecruit) paths.push({ params: { slug: "recruit" }, props: { kind: "recruit" } });
  if (hasMessage) paths.push({ params: { slug: "message" }, props: { kind: "message" } });
  return paths;
}
const { kind } = Astro.props;
const title = kind === "recruit" ? "採用情報" : "代表挨拶";

const analysis = analyze(project as any);
/** 写真の帯が見るのは、採用なら**働く人**、代表挨拶なら**代表者**である */
const source = narrowTo({ photos: photosOf(kind === "recruit" ? "働く人" : "代表者") });
const sections = composeVisual(
  composePage(kind, source, analysis, { direction: theme.direction, hasProse: hasDraft(kind) }),
  source, analysis, { direction: theme.direction },
);
---
<Base title={title} description={`${companyName}の${title}`}>
  <div class="page-head"><div class="inner">
    <h1>{title}</h1>
    {kind === "message" && project.basics?.representative && (
      <p>代表 {project.basics.representative}</p>
    )}
  </div></div>
  {sections.map((sec) => (
    <Band width={sec.width} emphasis={sec.emphasis} surface={sec.surface} motif={sec.motif} content={sec.content} presentation={sec.presentation}
          decidedBy={sec.decidedBy} density={sec.visual?.density} peak={sec.visual?.peak} role={sec.visual?.role} layout={sec.visual?.layout ?? sec.layout} heading={sec.kind === "prose" ? undefined : sec.heading}>
      <Present content={sec.content} presentation={sec.presentation} analysis={analysis} slug={kind} />
    </Band>
  ))}
  {kind === "recruit" && (
    <div class="section"><div class="inner">
      <p>ご応募・ご質問は<a href="/contact/">お問い合わせ</a>よりご連絡ください。</p>
    </div></div>
  )}
</Base>
