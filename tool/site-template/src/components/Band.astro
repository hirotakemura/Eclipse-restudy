---
/**
 * セクションの帯。
 *
 * **幅・地・組み方・地紋を属性で受ける。**
 * 何をどう出すかは `lib/design/sections.ts` が決め、ここは受け取ったとおりに描くだけ。
 * `.section` も付けるので、章の区切り（data-sections）と見出しの飾り（data-headings）はそのまま効く。
 */
interface Props {
  width?: "narrow" | "normal" | "wide" | "full";
  emphasis?: "lead" | "normal" | "quiet";
  surface?: string;
  layout?: string;
  motif?: string;
  /** 何を伝えるか・どう見せるか。**検証で数えるために出す**（D-212） */
  content?: string;
  presentation?: string;
  /**
   * この帯の見せ方を、最終的に誰が決めたか（rules / ai / ai-fallback）。
   * **AIの判断が本当に画面へ届いたかを、HTMLそのもので確かめるために出す**（ご指示）。
   */
  decidedBy?: string;
  heading?: string;
  /**
   * ページ全体を見て決めたもの（Phase 4・`lib/design/visual.ts`）。
   * **帯を1つずつ見ても決められないもの**だけがここに来る。
   */
  density?: string;
  peak?: string;
  /** 「一言を大きく」が長い文にかかっているか（D-433） */
  peakText?: "long";
  role?: string;
  /**
   * 素材の判断（docs/31・`lib/design/assets.ts`）。**第1段階では出すだけで、描画は変えない。**
   *
   * `assetSource` は **`"none"` のときも出す。**
   * ほかの属性（`data-peak` `data-motif`）は none を省いているが、ここだけは違う。
   * **素材を置かないことは「決まらなかった」ではなく「要らないと決めた」**であり、
   * 省くと決めたことが画面に残らない（docs/31 原則①）。
   */
  /**
   * **この帯は、その内容の本体ではない**（Owner / Reference の実証）。
   * 判定は `lib/design/system/owner.ts` の表だけが持つ。ここは受け取って出すだけ。
   * **画面では確かめられないので、HTMLに残す**（どちらで描かれたかを数えるため）。
   */
  reference?: boolean;
  assetSource?: string;
  assetIntent?: string;
  assetRole?: string;
  assetSubject?: string;
  /**
   * 実写が要るのに無い帯。**置き場所と、どれくらい効くか**を出す（第3段階）。
   * 写真の依頼はこの2つから作る。`why`（人に読ませる理由）は画面に出さない。
   */
  assetWanted?: string;
  assetPriority?: string;
  /**
   * 素材ライブラリから採ったとき**だけ**入る（第5段階・`lib/design/system/library.ts`）。
   *
   * 場所（`assetImage`）は**カスタムプロパティで渡す。**
   * CSS側にIDと場所の対応表を作ると、**同じことを2箇所で決める**ことになり、
   * 素材を1枚足すたびにCSSも直す羽目になる。単一の正は登録簿だけにする（D-197）。
   *
   * **`<img>` にはしない。** 地の層に敷くだけなので、
   * 画面でも、HTMLを読んでも、**お客様の実績写真と取り違えようがない。**
   */
  assetLibrary?: string;
  /** 生成ビジュアルを採ったときの注文書ID（第9段階）。**来歴を画面に残す** */
  assetGenerated?: string;
  assetImage?: string;
  /** 生成ビジュアルの焦点（`background-position`）。**スマホで切られても中心が残る** */
  assetFocal?: string;
}
const { width = "normal", emphasis = "normal", surface = "plain", layout = "stack", motif = "none", content, presentation, decidedBy, heading, density = "normal", peak, peakText, role,
  assetSource, assetIntent, assetRole, assetSubject, assetWanted, assetPriority, assetLibrary, assetGenerated, assetImage, assetFocal , reference } = Astro.props;
---
<section
  class="section band"
  data-width={width}
  data-emphasis={emphasis}
  data-surface={surface}
  data-layout={layout}
  data-motif={motif !== "none" ? motif : undefined}
  data-content={content}
  data-presentation={presentation}
  data-decided-by={decidedBy}
  data-density={density}
  data-reference={reference ? "" : undefined}
  data-peak={peak !== "none" ? peak : undefined}
  data-peak-text={peakText}
  data-role={role}
  data-asset-source={assetSource}
  data-asset-intent={assetIntent}
  data-asset-role={assetRole}
  data-asset-subject={assetSubject}
  data-asset-wanted={assetWanted}
  data-asset-priority={assetPriority}
  data-asset-library={assetLibrary}
  data-asset-generated={assetGenerated}
  style={assetImage ? `--asset-image:url(${assetImage})${assetFocal ? `;--asset-focal:${assetFocal}` : ""}` : undefined}
>
  <div class="inner">
    {heading && <h2>{heading}</h2>}
    <div class="band-body"><slot /></div>
    {/**
      * **絵は、列として置く**（D-450）。
      * 帯の地に薄く敷く方式では、実測で**最大画素差 4/255**——人には形として見えなかった（D-386）。
      * 最初の画面は列にして解決した（D-448）。帯も同じ考え方にする。
      * **絵が無ければ、この要素ごと出ない**ので、持たない案件は1pxも変わらない
      */}
    {assetSource === "generated" && <div class="band-visual" role="presentation"></div>}
  </div>
</section>
