---
/**
 * セクションの帯。
 *
 * **幅・地・組み方・地紋を属性で受ける。**
 * 何をどう出すかは `lib/design/sections.ts` が決め、ここは受け取ったとおりに描くだけ。
 * `.section` も付けるので、章の区切り（data-sections）と見出しの飾り（data-headings）はそのまま効く。
 */
interface Props {
  width?: "narrow" | "normal" | "wide" | "full";
  emphasis?: "lead" | "normal" | "quiet";
  surface?: string;
  layout?: string;
  motif?: string;
  /** 何を伝えるか・どう見せるか。**検証で数えるために出す**（D-212） */
  content?: string;
  presentation?: string;
  /**
   * この帯の見せ方を、最終的に誰が決めたか（rules / ai / ai-fallback）。
   * **AIの判断が本当に画面へ届いたかを、HTMLそのもので確かめるために出す**（ご指示）。
   */
  decidedBy?: string;
  heading?: string;
  /**
   * ページ全体を見て決めたもの（Phase 4・`lib/design/visual.ts`）。
   * **帯を1つずつ見ても決められないもの**だけがここに来る。
   */
  density?: string;
  peak?: string;
  role?: string;
}
const { width = "normal", emphasis = "normal", surface = "plain", layout = "stack", motif = "none", content, presentation, decidedBy, heading, density = "normal", peak = "none", role } = Astro.props;
---
<section
  class="section band"
  data-width={width}
  data-emphasis={emphasis}
  data-surface={surface}
  data-layout={layout}
  data-motif={motif !== "none" ? motif : undefined}
  data-content={content}
  data-presentation={presentation}
  data-decided-by={decidedBy}
  data-density={density}
  data-peak={peak !== "none" ? peak : undefined}
  data-role={role}
>
  <div class="inner">
    {heading && <h2>{heading}</h2>}
    <div class="band-body"><slot /></div>
  </div>
</section>
