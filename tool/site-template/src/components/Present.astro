---
/**
 * 内容 × 表現 で描き分ける。
 *
 * **「何を伝えるか」と「どう見せるか」を分けた**（D-206）ので、
 * 同じ内容でも会社によって違う形で出る。
 * どの組み合わせが来るかは `lib/design/` が決め、可否表と材料の条件を通してある。
 * **ここは受け取ったとおりに描くだけ。**
 */
import Figures from "./sections/Figures.astro";
import BigNumber from "./sections/BigNumber.astro";
import Comparison from "./sections/Comparison.astro";
import Process from "./sections/Process.astro";
import Longform from "./sections/Longform.astro";
import ListView from "./sections/ListView.astro";
import Declined from "./sections/Declined.astro";
import Technique from "./sections/Technique.astro";
import Materials from "./sections/Materials.astro";
import Equipment from "./sections/Equipment.astro";
import Timeline from "./sections/Timeline.astro";
import People from "./sections/People.astro";
import Points from "./sections/Points.astro";
import Offerings from "./sections/Offerings.astro";
import Table from "./Table.astro";
import Gallery from "./Gallery.astro";
import CaseCard from "./CaseCard.astro";
import Prose from "./Prose.astro";
import { cardGrid } from "../lib/cards";
import { project, cases, rows, photosOf, photosOfCase, tel, telHref, email, serviceArea, isGeneral, reasonChosen, idealCustomer, offerings, webOf } from "../lib/site";
import InquiryForm from "./InquiryForm.astro";
import { splitParts } from "../lib/text";

/**
 * @param slug いまどのページを描いているか。原稿の差し込み先の指定も兼ねる。
 *             **自分自身へのリンクを出さないため**に要る（強みページに
 *             「強み・技術をくわしく見る」が出ていては、ただの行き止まり）。
 */
/**
 * @param caseNo 事例の個別ページで、**どの案件を描いているか**（1始まり・D-301）。
 *               渡されたときは、事例・写真・材質の帯が**その1件だけ**を出す。
 *               渡さなければ、これまでどおり全件から選ぶ。
 */
interface Props { content: string; presentation: string; analysis: any; slug?: string; caseNo?: number; draftSlug?: string }
const { content, presentation, analysis, slug, caseNo, draftSlug } = Astro.props;
const page = slug ?? "index";
/** この帯が見ている事例。個別ページなら1件、それ以外は undefined */
const only: any = caseNo ? cases[caseNo - 1] : undefined;
/** 自分のページへは張らない */
const linkTo = (to: string) => (page === to ? undefined : `/${to}/`);

const cap = (project as any).capability ?? {};
const basics = (project as any).basics ?? {};
/**
 * 強みの文章。**掲載文があればそれを、無ければ取材原文を出す**（第10段階①）。
 * ここで一度だけ当てておく——**画面に出す箇所ごとに `webOf` を書くと、必ず書き忘れる**（D-197）。
 * 判定に使う `analysis` はこれを通らないので、**構成も型もモチーフも動かない。**
 */
const stRaw = (project as any).strengths ?? {};
const ex = (project as any).executive ?? {};
const st = {
  ...stRaw,
  wonAfterOthersDeclined: webOf("strengths.wonAfterOthersDeclined", stRaw.wonAfterOthersDeclined),
  followUpFindings: webOf("strengths.followUpFindings", stRaw.followUpFindings),
  workOthersAvoid: webOf("strengths.workOthersAvoid", stRaw.workOthersAvoid),
  hardestJob: webOf("strengths.hardestJob", stRaw.hardestJob),
  praiseFromClients: webOf("strengths.praiseFromClients", stRaw.praiseFromClients),
};
const vision = webOf("executive.vision", ex.vision);
const messageToStaff = webOf("executive.messageToStaff", ex.messageToStaff);
const businessSummary = webOf("basics.businessSummary", basics.businessSummary);

/**
 * 事例を「ご相談 → 対応 → 結果」の工程として見せる。
 *
 * **1件だけを出す**（D-237）。
 * 直す前は全事例の項目を順に並べていたため、
 * **「①ご相談 ②対応 ③ご相談 ④結果 ⑤ご相談 ⑥ご相談」**という番号が付き、
 * 別々の案件がひと続きの工程に見えていた。読んで意味が通らない。
 * 工程は**順序に意味がある**表現なので、順序が本当にあるもの＝1件の中だけに使う。
 */
const caseForProcess = only ?? cases.find((c: any) => c.challenge && c.solution && c.result) ?? cases[0];
const caseSteps = (caseForProcess
  ? [
      { title: "ご相談の内容", body: caseForProcess.challenge },
      { title: "対応した内容", body: caseForProcess.solution },
      { title: "結果", body: caseForProcess.result },
    ]
  : []).filter((x) => x.body) as { title: string; body: string }[];

const techSteps = splitParts(st.followUpFindings).map((x) => ({ title: x.title ?? "", body: x.body }));
const quoteOf = (v: string) => (/[「『][^」』]{4,}[」』]/.exec(v ?? "") ?? [])[0] ?? v;
const equipTotal = (cap.equipment ?? []).reduce((s: number, e: any) => s + (Number(e.count) || 0), 0);
/**
 * **外注の工程を、自社と同じ行に置かない**（D-424）。
 * 同じ行に並ぶと、その設備を持っていると読める。外注を記録した案件だけ「（自社）」を付けて分ける。
 * 記録が無い案件（既存42件）では、行も見出しも1文字も変わらない。
 */
const outsourced = (cap.outsourcedProcesses ?? []) as string[];
const processLabel = outsourced.length ? "加工法・工法（自社）" : "加工法・工法";
const specRows = rows([
  ["対応材質", cap.materials], [processLabel, cap.processes],
  ["協力会社に依頼している工程", outsourced],
  ["対応サイズ（最大）", cap.maxSize], ["対応サイズ（最小）", cap.minSize],
  ["対応精度", cap.tolerance], ["対応ロット", cap.lotSize],
  ["最短納期", cap.shortestLeadTime], ["資格・認証", cap.certifications],
  ["稼働体制", cap.operatingHours],
]);
/**
 * 設備一覧の表。**「設備・メーカー・台数」の3列**（D-237）。
 * 型番もメーカーも分からないものは載せない（載せると空行が並ぶだけになる）。
 */
const eqRows: string[][] = (cap.equipment ?? [])
  .filter((e: any) => e?.maker || e?.model)
  .map((e: any) => [e.model || e.maker, e.model ? (e.maker ?? "") : "", e.count ? `${e.count}台` : ""]);
const shownCases = cases.slice(0, 6);
const grid = cardGrid(shownCases.length);
/**
 * 塊として並べるもの。
 * **汎用ベーシック（198,000円）には「同業が敬遠しがちな仕事」が無い。**
 * 中原設備などの既存案件を壊さないよう、商品ごとに中身を変える（ご指示①）。
 */
/**
 * 募集要項。**条件の書いていない求人は応募されない**（D-171）。
 * 聞けていない項目は行ごと出さない。空欄の並んだ表のほうが不信を招く。
 */
const rt = ((project as any).recruitment?.terms ?? {}) as any;
const recruitTerms = rows([
  ["雇用形態", rt.employmentType], ["給与", rt.salary], ["勤務時間", rt.workingHours],
  ["休日・休暇", rt.holidays], ["諸手当", rt.allowances], ["社会保険", rt.insurance],
  ["応募資格", rt.qualifications], ["選考の流れ", rt.selection], ["応募書類", rt.documents],
  ["お問い合わせ", rt.contact], ["工場見学", rt.factoryTour],
]);
/**
 * `retentionNotes`（若手の定着状況）は**我々が採用ページの要否を判断するための欄**で、
 * 載せる欄ではない（D-170）。ここには出さない。
 */
const rr = ((project as any).recruitment ?? {}) as any;
const recruitBlocks = ([
  ["募集している職種", (rr.neededRoles ?? []).join("、")],
  ["職場について", (rr.workplaceAppeal ?? []).join("、")],
].filter(([, v]) => v)) as [string, string][];

const points = ((isGeneral
  ? [
      ["お客様からよくいただく言葉", st.praiseFromClients],
      ["どういうお客様が多いか", idealCustomer],
    ]
  : [
      ["お客様からよくいただく言葉", st.praiseFromClients],
      ["同業が敬遠しがちな仕事", st.workOthersAvoid],
      ["技術的に最も難しかった仕事", st.hardestJob],
    ]) as [string, string][]).filter(([, v]) => v);
---
{/** 原稿の差し込み先は、ページ名と違うことがある（事例は `case-1`・D-301） */}
{content === "draft" && <Prose slug={draftSlug ?? page} />}

{/* 取り扱い（汎用プランの中心・D-272）。**構成システムの中で出す** */}
{content === "offerings" && presentation === "cardGrid" && <Offerings offerings={offerings} href={offerings.length > 3 ? "/services/" : undefined} />}
{content === "offerings" && presentation === "spec" && (
  <Table head={["サービス", "料金の目安"]} rows={offerings.map((o: any) => [o.name, o.price || "お問い合わせください"])} />
)}
{content === "offerings" && presentation === "list" && <ListView items={offerings.map((o: any) => o.name).filter(Boolean)} />}
{content === "offerings" && presentation === "longform" && (
  <Longform text={offerings.map((o: any) => [o.name, o.detail].filter(Boolean).join("\n")).join("\n\n")} />
)}
{content === "offerings" && presentation === "prose" && (
  <p>{offerings.map((o: any) => o.name).filter(Boolean).join("・")}</p>
)}

{content === "conditions" && presentation === "largeNumber" && <Figures figures={analysis.figures} />}
{content === "conditions" && presentation === "spec" && <Table rows={specRows} />}
{content === "conditions" && presentation === "comparison" && (
  <Comparison label="標準の納期" text={cap.shortestLeadTime} />
)}
{/* **本体は対応可能範囲のページ。** ここは判断に効く数字だけ並べて、本体へ送る（Owner / Reference） */}
{content === "conditions" && presentation === "list" && (
  <>
    <ListView items={analysis.figures.map((f: any) => `${f.label}：${f.value}`)} />
    {page !== "capability" && <p><a href="/capability/">対応可能範囲をすべて見る</a></p>}
  </>
)}

{content === "materials" && presentation === "chips" && (
  <Materials materials={(only ? only.materials : cap.materials) ?? []}
             processes={(only ? only.processes : cap.processes) ?? []}
             outsourced={only ? [] : outsourced}
             href={linkTo("capability")} />
)}
{content === "materials" && presentation === "list" && <ListView items={cap.materials ?? []} />}
{content === "materials" && presentation === "spec" && (
  <Table rows={rows([["対応材質", cap.materials], [processLabel, cap.processes], ["協力会社に依頼している工程", outsourced]])} />
)}

{content === "equipment" && presentation === "cardGrid" && <Equipment equipment={cap.equipment ?? []} href={linkTo("equipment")} />}
{content === "equipment" && presentation === "spec" && <Table head={["設備", "メーカー", "台数"]} rows={eqRows} />}
{content === "equipment" && presentation === "largeNumber" && (
  <BigNumber items={[{ label: "保有設備", value: `${equipTotal}台` }]} />
)}
{content === "equipment" && presentation === "list" && (
  <ListView items={(cap.equipment ?? []).map((e: any) => [e.model || e.maker, e.count ? `${e.count}台` : ""].filter(Boolean).join("　"))} />
)}

{content === "cases" && presentation === "cardGrid" && (
  <>
    <div class={`cards${grid.orphan ? " has-orphan" : ""}`} style={`--cols:${grid.cols}`}>
      {shownCases.map((c: any, i: number) => <CaseCard index={i} item={c} />)}
    </div>
    {/**
      * **本体でないページには、必ず本体への導線を出す**（Owner / Reference）。
      * 以前は「6件を超えるとき」だけ出していたので、4件の会社では
      * **カードだけ並んで一覧への行き先が無かった。** 工程・引用の分岐は前から `page` だけを見ている。
      */}
    {page !== "cases" && <p style="margin-top:20px"><a href="/cases/">{isGeneral ? "実績" : "加工事例"}をすべて見る</a></p>}
  </>
)}
{content === "cases" && presentation === "process" && (
  <>
    {/* **どの案件の話かを先に言う。** 言わないと、工程だけが宙に浮く */}
    {caseForProcess?.title && <h3 style="margin-top:0">{caseForProcess.title}</h3>}
    <Process steps={caseSteps} />
    {page !== "cases" && <p><a href="/cases/">{isGeneral ? "実績" : "加工事例"}をすべて見る</a></p>}
  </>
)}
{content === "cases" && presentation === "quote" && (
  <>
    <Declined text={quoteOf(cases.map((c: any) => c.challenge).filter(Boolean).join(" "))} />
    {page !== "cases" && <p><a href="/cases/">{isGeneral ? "実績" : "加工事例"}をすべて見る</a></p>}
  </>
)}
{content === "cases" && presentation === "spec" && !only && (
  <Table rows={rows(cases.map((c: any) => [c.title, [c.materials?.join("・"), c.quantity, c.leadTime].filter(Boolean).join("／")]))} />
)}
{/* 事例の個別ページ。**この1件の条件だけ**を出す（D-301・D-172） */}
{content === "cases" && presentation === "spec" && only && (
  <>
    {only.partDescription && <div class="note-box">{only.partDescription}</div>}
    <Table rows={rows([
      ["材質", only.materials], ["数量・ロット", only.quantity], ["納期", only.leadTime],
      ["加工法", only.processes], ["他社様でお断りになった理由", only.declinedReason],
    ])} />
  </>
)}

{content === "technique" && presentation === "prose" && <Technique text={st.followUpFindings} praise={page === "strengths" ? undefined : st.praiseFromClients} href={linkTo("strengths")} />}
{content === "technique" && presentation === "longform" && <Longform text={st.followUpFindings} quote={st.praiseFromClients} />}
{content === "technique" && presentation === "process" && (
  <>
    <Process steps={techSteps} />
    {page !== "strengths" && <p><a href="/strengths/">強み・技術をくわしく見る</a></p>}
  </>
)}
{/* **本体は強み・技術のページ。** ここは見出しだけを並べて、本体へ送る（Owner / Reference） */}
{content === "technique" && presentation === "list" && (
  <>
    <ListView items={techSteps.map((s) => s.title || s.body.slice(0, 40))} />
    {page !== "strengths" && <p><a href="/strengths/">強み・技術をくわしく見る</a></p>}
  </>
)}

{content === "declined" && presentation === "quote" && (
  <Declined text={isGeneral ? reasonChosen : st.wonAfterOthersDeclined} href={linkTo("strengths")}
            linkLabel={isGeneral ? "くわしく見る" : "なぜ受けられるのか（強み・技術）"} />
)}
{content === "declined" && presentation === "prose" && <p>{isGeneral ? reasonChosen : st.wonAfterOthersDeclined}</p>}
{content === "declined" && presentation === "longform" && (
  <Longform text={[st.wonAfterOthersDeclined, st.workOthersAvoid, st.hardestJob].filter(Boolean).join("\n\n")} />
)}

{content === "praise" && presentation === "cardGrid" && <Points points={points} />}
{content === "praise" && presentation === "quote" && <Declined text={quoteOf(st.praiseFromClients)} />}
{content === "praise" && presentation === "prose" && <p>{st.praiseFromClients}</p>}

{content === "history" && presentation === "timeline" && <Timeline history={basics.history ?? []} founded={basics.founded} />}
{content === "history" && presentation === "list" && <ListView items={(basics.history ?? []).map((h: any) => `${h.year}　${h.event}`)} />}
{content === "history" && presentation === "prose" && basics.founded && <p>創業 {basics.founded}</p>}
{content === "history" && presentation === "longform" && (
  <Longform text={(basics.history ?? []).map((h: any) => `${h.year}　${h.event}`).join("\n\n")} />
)}

{content === "executive" && presentation === "prose" && (
  <People vision={vision} representative={basics.representative} href={linkTo("message")} />
)}
{content === "executive" && presentation === "quote" && <Declined text={quoteOf(messageToStaff ?? vision)} />}
{/**
  * **代表挨拶のページでは、すぐ上の帯が「これからの5年」を出している。**
  * ここで両方を出すと同じ文章が2度並ぶので、社員に伝えたいことだけにする（D-301）。
  */}
{content === "executive" && presentation === "longform" && (
  <Longform text={(page === "message"
    ? [messageToStaff]
    : [vision, messageToStaff]
  ).filter(Boolean).join("\n\n")} />
)}

{/**
  * 写真の帯は、**そのページが見るべき写真**を出す（D-301）。
  * 直す前はどのページでも「工場・設備」で、代表挨拶に工場の写真が出ていた。
  */}
{content === "photos" && (
  <Gallery photos={
    caseNo ? photosOfCase(caseNo)
    : page === "cases" ? photosOf("加工事例")
    : page === "company" ? photosOf("外観")
    : page === "message" ? photosOf("代表者")
    : page === "recruit" ? photosOf("働く人")
    : photosOf("工場・設備")
  } />
)}

{/* ── 会社概要・採用・お問い合わせ（D-301）────────────── */}
{content === "profile" && presentation === "spec" && (
  <Table rows={rows([
    ["会社名", basics.name], ["代表者", basics.representative], ["創業", basics.founded],
    ["資本金", basics.capital], ["従業員数", basics.employees ? `${basics.employees}名` : ""],
    ["所在地", basics.address], ["電話番号", tel], ["メールアドレス", email],
    ["事業内容", businessSummary], ["主要取引先の業界", basics.clientIndustries],
  ])} />
)}
{content === "profile" && presentation === "list" && (
  <ListView items={[basics.address, tel, basics.founded].filter(Boolean)} />
)}

{content === "recruit" && presentation === "spec" && <Table rows={recruitTerms} />}
{content === "recruit" && presentation === "list" && <ListView items={recruitBlocks.map(([h]) => h)} />}
{/**
  * **塊が1つしかないときは、小見出しを出さない。**
  * 帯の見出しは `heads.join("・")` で作られている（`sections.ts`）ので、
  * 塊が1つだと**帯の見出しと小見出しがまったく同じ言葉**になる。
  * 実測：採用情報のページが `募集している職種`（h2）→ `募集している職種`（h3）→ 1行、
  * という画面になっていた。**2つ以上あるときだけ、区別のために出す。**
  */}
{content === "recruit" && presentation === "prose" && (
  <>{recruitBlocks.map(([h, body]) => <>{recruitBlocks.length > 1 && <h3>{h}</h3>}<p>{body}</p></>)}</>
)}

{/* ご連絡先。**電話とメールは、用紙と同じページに必ず置く**（D-060） */}
{content === "inquiry" && presentation === "list" && (
  <div class="table-wrap">
    <table><tbody>
      {tel && <tr><th scope="row">電話</th><td><a href={`tel:${telHref}`}>{tel}</a></td></tr>}
      {email && <tr><th scope="row">メール</th><td><a href={`mailto:${email}`}>{email}</a></td></tr>}
      {basics.address && <tr><th scope="row">所在地</th><td>{basics.address}</td></tr>}
      {cap.operatingHours && <tr><th scope="row">稼働体制</th><td>{cap.operatingHours}</td></tr>}
    </tbody></table>
  </div>
)}
{/**
  * **書くことが分かってから、用紙に入る。**
  * 先に用紙を出すと、何を書けばよいか分からないまま空欄を見ることになる。
  */}
{content === "inquiry" && presentation === "prose" && (
  <>
    <h3>ご相談の際にお知らせいただきたいこと</h3>
    <p>下記が分かると、お返事が早くなります。分かる範囲で構いません。</p>
    {isGeneral ? (
      <>
        <ul>
          <li>ご相談の内容（どこが、どのような状態か）</li>
          <li>ご希望の時期</li>
          <li>お住まい・所在地の地域</li>
          <li>ご予算の目安（お決まりであれば）</li>
        </ul>
        {serviceArea && <p>対応エリア：{serviceArea}</p>}
      </>
    ) : (
      <>
        <ul>
          <li>図面（PDF・DXFなど。お手元にあるものでかまいません）</li>
          <li>材質</li>
          <li>数量</li>
          <li>ご希望の納期</li>
          <li>用途・使われ方（精度の要否の判断に使います）</li>
        </ul>
        <p>図面がまだ固まっていない段階のご相談も承ります。</p>
      </>
    )}
    <InquiryForm tel={tel} email={email} />
  </>
)}
