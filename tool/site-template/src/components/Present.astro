---
/**
 * 内容 × 表現 で描き分ける。
 *
 * **「何を伝えるか」と「どう見せるか」を分けた**（D-206）ので、
 * 同じ内容でも会社によって違う形で出る。
 * どの組み合わせが来るかは `lib/design/` が決め、可否表と材料の条件を通してある。
 * **ここは受け取ったとおりに描くだけ。**
 */
import Figures from "./sections/Figures.astro";
import BigNumber from "./sections/BigNumber.astro";
import Comparison from "./sections/Comparison.astro";
import Process from "./sections/Process.astro";
import Longform from "./sections/Longform.astro";
import ListView from "./sections/ListView.astro";
import Declined from "./sections/Declined.astro";
import Technique from "./sections/Technique.astro";
import Materials from "./sections/Materials.astro";
import Equipment from "./sections/Equipment.astro";
import Timeline from "./sections/Timeline.astro";
import People from "./sections/People.astro";
import Points from "./sections/Points.astro";
import Table from "./Table.astro";
import Gallery from "./Gallery.astro";
import CaseCard from "./CaseCard.astro";
import Prose from "./Prose.astro";
import { cardGrid } from "../lib/cards";
import { project, cases, rows, photosOf, isGeneral, reasonChosen, idealCustomer } from "../lib/site";
import { splitParts } from "../lib/text";

/**
 * @param slug いまどのページを描いているか。原稿の差し込み先の指定も兼ねる。
 *             **自分自身へのリンクを出さないため**に要る（強みページに
 *             「強み・技術をくわしく見る」が出ていては、ただの行き止まり）。
 */
interface Props { content: string; presentation: string; analysis: any; slug?: string }
const { content, presentation, analysis, slug } = Astro.props;
const page = slug ?? "index";
/** 自分のページへは張らない */
const linkTo = (to: string) => (page === to ? undefined : `/${to}/`);

const cap = (project as any).capability ?? {};
const st = (project as any).strengths ?? {};
const basics = (project as any).basics ?? {};

/**
 * 事例を「ご相談 → 対応 → 結果」の工程として見せる。
 *
 * **1件だけを出す**（D-237）。
 * 直す前は全事例の項目を順に並べていたため、
 * **「①ご相談 ②対応 ③ご相談 ④結果 ⑤ご相談 ⑥ご相談」**という番号が付き、
 * 別々の案件がひと続きの工程に見えていた。読んで意味が通らない。
 * 工程は**順序に意味がある**表現なので、順序が本当にあるもの＝1件の中だけに使う。
 */
const caseForProcess = cases.find((c: any) => c.challenge && c.solution && c.result) ?? cases[0];
const caseSteps = (caseForProcess
  ? [
      { title: "ご相談の内容", body: caseForProcess.challenge },
      { title: "対応した内容", body: caseForProcess.solution },
      { title: "結果", body: caseForProcess.result },
    ]
  : []).filter((x) => x.body) as { title: string; body: string }[];

const techSteps = splitParts(st.followUpFindings).map((x) => ({ title: x.title ?? "", body: x.body }));
const quoteOf = (v: string) => (/[「『][^」』]{4,}[」』]/.exec(v ?? "") ?? [])[0] ?? v;
const equipTotal = (cap.equipment ?? []).reduce((s: number, e: any) => s + (Number(e.count) || 0), 0);
const specRows = rows([
  ["対応材質", cap.materials], ["加工法・工法", cap.processes],
  ["対応サイズ（最大）", cap.maxSize], ["対応サイズ（最小）", cap.minSize],
  ["対応精度", cap.tolerance], ["対応ロット", cap.lotSize],
  ["最短納期", cap.shortestLeadTime], ["資格・認証", cap.certifications],
  ["稼働体制", cap.operatingHours],
]);
/**
 * 設備一覧の表。**「設備・メーカー・台数」の3列**（D-237）。
 * 型番もメーカーも分からないものは載せない（載せると空行が並ぶだけになる）。
 */
const eqRows: string[][] = (cap.equipment ?? [])
  .filter((e: any) => e?.maker || e?.model)
  .map((e: any) => [e.model || e.maker, e.model ? (e.maker ?? "") : "", e.count ? `${e.count}台` : ""]);
const shownCases = cases.slice(0, 6);
const grid = cardGrid(shownCases.length);
/**
 * 塊として並べるもの。
 * **汎用ベーシック（198,000円）には「同業が敬遠しがちな仕事」が無い。**
 * 中原設備などの既存案件を壊さないよう、商品ごとに中身を変える（ご指示①）。
 */
const points = ((isGeneral
  ? [
      ["お客様からよくいただく言葉", st.praiseFromClients],
      ["どういうお客様が多いか", idealCustomer],
    ]
  : [
      ["お客様からよくいただく言葉", st.praiseFromClients],
      ["同業が敬遠しがちな仕事", st.workOthersAvoid],
      ["技術的に最も難しかった仕事", st.hardestJob],
    ]) as [string, string][]).filter(([, v]) => v);
---
{content === "draft" && <Prose slug={slug ?? "index"} />}

{content === "conditions" && presentation === "largeNumber" && <Figures figures={analysis.figures} />}
{content === "conditions" && presentation === "spec" && <Table rows={specRows} />}
{content === "conditions" && presentation === "comparison" && (
  <Comparison label="標準の納期" text={cap.shortestLeadTime} />
)}
{content === "conditions" && presentation === "list" && (
  <ListView items={analysis.figures.map((f: any) => `${f.label}：${f.value}`)} />
)}

{content === "materials" && presentation === "chips" && (
  <Materials materials={cap.materials ?? []} processes={cap.processes ?? []} href={linkTo("capability")} />
)}
{content === "materials" && presentation === "list" && <ListView items={cap.materials ?? []} />}
{content === "materials" && presentation === "spec" && (
  <Table rows={rows([["対応材質", cap.materials], ["加工法・工法", cap.processes]])} />
)}

{content === "equipment" && presentation === "cardGrid" && <Equipment equipment={cap.equipment ?? []} href={linkTo("equipment")} />}
{content === "equipment" && presentation === "spec" && <Table head={["設備", "メーカー", "台数"]} rows={eqRows} />}
{content === "equipment" && presentation === "largeNumber" && (
  <BigNumber items={[{ label: "保有設備", value: `${equipTotal}台` }]} />
)}
{content === "equipment" && presentation === "list" && (
  <ListView items={(cap.equipment ?? []).map((e: any) => [e.model || e.maker, e.count ? `${e.count}台` : ""].filter(Boolean).join("　"))} />
)}

{content === "cases" && presentation === "cardGrid" && (
  <>
    <div class={`cards${grid.orphan ? " has-orphan" : ""}`} style={`--cols:${grid.cols}`}>
      {shownCases.map((c: any, i: number) => <CaseCard index={i} item={c} />)}
    </div>
    {cases.length > 6 && page !== "cases" && <p style="margin-top:20px"><a href="/cases/">{isGeneral ? "実績" : "加工事例"}をすべて見る</a></p>}
  </>
)}
{content === "cases" && presentation === "process" && (
  <>
    {/* **どの案件の話かを先に言う。** 言わないと、工程だけが宙に浮く */}
    {caseForProcess?.title && <h3 style="margin-top:0">{caseForProcess.title}</h3>}
    <Process steps={caseSteps} />
    {page !== "cases" && <p><a href="/cases/">{isGeneral ? "実績" : "加工事例"}をすべて見る</a></p>}
  </>
)}
{content === "cases" && presentation === "quote" && (
  <>
    <Declined text={quoteOf(cases.map((c: any) => c.challenge).filter(Boolean).join(" "))} />
    {page !== "cases" && <p><a href="/cases/">{isGeneral ? "実績" : "加工事例"}をすべて見る</a></p>}
  </>
)}
{content === "cases" && presentation === "spec" && (
  <Table rows={rows(cases.map((c: any) => [c.title, [c.materials?.join("・"), c.quantity, c.leadTime].filter(Boolean).join("／")]))} />
)}

{content === "technique" && presentation === "prose" && <Technique text={st.followUpFindings} praise={page === "strengths" ? undefined : st.praiseFromClients} href={linkTo("strengths")} />}
{content === "technique" && presentation === "longform" && <Longform text={st.followUpFindings} quote={st.praiseFromClients} />}
{content === "technique" && presentation === "process" && (
  <>
    <Process steps={techSteps} />
    {page !== "strengths" && <p><a href="/strengths/">強み・技術をくわしく見る</a></p>}
  </>
)}
{content === "technique" && presentation === "list" && <ListView items={techSteps.map((s) => s.title || s.body.slice(0, 40))} />}

{content === "declined" && presentation === "quote" && (
  <Declined text={isGeneral ? reasonChosen : st.wonAfterOthersDeclined} href={linkTo("strengths")}
            linkLabel={isGeneral ? "くわしく見る" : "なぜ受けられるのか（強み・技術）"} />
)}
{content === "declined" && presentation === "prose" && <p>{isGeneral ? reasonChosen : st.wonAfterOthersDeclined}</p>}
{content === "declined" && presentation === "longform" && (
  <Longform text={[st.wonAfterOthersDeclined, st.workOthersAvoid, st.hardestJob].filter(Boolean).join("\n\n")} />
)}

{content === "praise" && presentation === "cardGrid" && <Points points={points} />}
{content === "praise" && presentation === "quote" && <Declined text={quoteOf(st.praiseFromClients)} />}
{content === "praise" && presentation === "prose" && <p>{st.praiseFromClients}</p>}

{content === "history" && presentation === "timeline" && <Timeline history={basics.history ?? []} founded={basics.founded} />}
{content === "history" && presentation === "list" && <ListView items={(basics.history ?? []).map((h: any) => `${h.year}　${h.event}`)} />}
{content === "history" && presentation === "prose" && basics.founded && <p>創業 {basics.founded}</p>}
{content === "history" && presentation === "longform" && (
  <Longform text={(basics.history ?? []).map((h: any) => `${h.year}　${h.event}`).join("\n\n")} />
)}

{content === "executive" && presentation === "prose" && (
  <People vision={(project as any).executive?.vision} representative={basics.representative} href={linkTo("message")} />
)}
{content === "executive" && presentation === "quote" && <Declined text={quoteOf((project as any).executive?.messageToStaff ?? (project as any).executive?.vision)} />}
{content === "executive" && presentation === "longform" && (
  <Longform text={[(project as any).executive?.vision, (project as any).executive?.messageToStaff].filter(Boolean).join("\n\n")} />
)}

{content === "photos" && <Gallery photos={photosOf("工場・設備")} />}
