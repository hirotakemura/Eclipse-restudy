---
/** 聞き取ったデータをそのまま出す表。空欄の行は作らない */
interface Props { rows: [string, string][]; caption?: string }
const { rows, caption } = Astro.props;
---
{rows.length > 0 && (
  <div class="table-wrap">
    <table>
      {caption && <caption>{caption}</caption>}
      <tbody>
        {rows.map(([label, value]) => (
          <tr>
            <th scope="row">{label}</th>
            <td>{value}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
)}
