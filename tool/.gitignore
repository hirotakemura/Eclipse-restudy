node_modules/

# 顧客の非公開情報が入るため、絶対にコミットしない
projects/*
!projects/.gitkeep

.env
.env.local

# サイトテンプレートに流し込む案件データ。顧客の情報そのものなのでコミットしない
site-template/src/site-data/*
!site-template/src/site-data/.gitkeep
site-template/dist/
site-template/.astro/

# サイト書き出しの作業用フォルダ
projects/*/.build/

# 書き出しのたびに build-site.mjs が案件の写真をここへ複製する。
# **お客様の写真そのものなので、絶対にコミットしない。**
# 一度 Git に入ってしまっていた（D-186）
site-template/public/photos/
# 生成ビジュアルの配り先。**書き出しのたびに作られる**ので、中身は追跡しない
# （第9段階で build-site.mjs に配布を足したとき、この1行を足し忘れていた——
#   写真の側（上の行）と同じ扱いにする。お客様の絵を git に載せない）
site-template/public/generated/
