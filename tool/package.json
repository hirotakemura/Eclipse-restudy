{
  "name": "kobo",
  "private": true,
  "version": "0.1.0",
  "description": "ヒアリング入力からWebサイトを生成する自社制作基盤",
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "demo": "node make-demo.mjs",
    "qa:directions": "node qa-directions.mjs",
    "qa:companies": "node qa-companies.mjs",
    "typecheck": "tsc --noEmit",
    "generate": "node generate.mjs",
    "brief": "node brief.mjs",
    "test:verify": "node verify.test.mjs",
    "test:internal": "node internal-language.test.mjs",
    "test:design": "node design.test.mjs",
    "test:presentation": "node presentation.test.mjs",
    "test:prompt": "node prompt.test.mjs",
    "test:brief": "node brief.test.mjs",
    "build:site": "node build-site.mjs",
    "dev:site": "node build-site.mjs --dev",
    "preview:site": "node preview-site.mjs",
    "import:photos": "node import-photos.mjs",
    "dns": "node dns-snapshot.mjs",
    "test:contrast": "node contrast.test.mjs",
    "test": "npm run test:verify && npm run test:internal && npm run test:design && npm run test:presentation && npm run test:prompt && npm run test:brief && npm run test:contrast"
