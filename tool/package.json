{
  "name": "kobo",
  "private": true,
  "version": "0.1.0",
  "description": "ヒアリング入力からWebサイトを生成する自社制作基盤",
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "typecheck": "tsc --noEmit",
    "generate": "node generate.mjs",
    "test:verify": "node verify.test.mjs",
    "build:site": "node build-site.mjs",
    "dev:site": "node build-site.mjs --dev",
    "preview:site": "node preview-site.mjs",
    "import:photos": "node import-photos.mjs"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0"
  }
}
